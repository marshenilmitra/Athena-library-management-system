# ============================================================
# Athena LMS — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to version control.
# ============================================================

# -----------------------------------------------------------
# Flask Secret Key (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------
SECRET_KEY=change_me_to_a_64_char_random_hex_string

# -----------------------------------------------------------
# Database Path (SQLite)
# Default: backend/lms.db (relative to project root)
# Render: set to /var/data/lms.db (persistent disk mount)
# -----------------------------------------------------------
DATABASE_URL=backend/lms.db

# -----------------------------------------------------------
# CORS Allowed Origin
# Set to your Vercel frontend URL in production.
# Use * for local development only.
# -----------------------------------------------------------
ALLOWED_ORIGIN=http://localhost:5000

# -----------------------------------------------------------
# Server Debug Mode
# Must be "false" in production.
# -----------------------------------------------------------
DEBUG=false

# -----------------------------------------------------------
# Server Port
# Render auto-sets PORT; override for local development.
# -----------------------------------------------------------
PORT=5000

# -----------------------------------------------------------
# Seed Account Passwords (used only on first DB initialization)
# Change these before first deployment!
# -----------------------------------------------------------
ADMIN_PASSWORD=Admin@123
LIBRARIAN_PASSWORD=Lib@123
MEMBER_PASSWORD=Mem@123
